# Copy to api.env and fill in. Never commit api.env — it holds secret keys.
#
# The agent's two brains, on their direct routes (the defaults):
OPENAI_API_KEY=sk-...        # generation model  (default: gpt-5.4-nano, reasoning effort none)
TYPESAFE_API_KEY=apikey...   # Jev decision model (default: jev-latest)
#
# Only needed if you point either brain at the Vercel AI Gateway instead
# (Settings -> LLM Debugger -> llmProvider / jevProvider = "vercel"):
# AI_GATEWAY_API_KEY=vck_...
